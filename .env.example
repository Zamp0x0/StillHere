# Copy this file to .env (ignored by git) and fill in only what you need. Everything is optional.
# Precedence (later wins): defaults < .env < environment variables < the profile's runtime/settings.json < command-line flags.
# Never put a real key in a committed file, an issue, a log or a screenshot.

# ---- where your private profiles live (default: ~/.stillhere/personas; must be outside a git repository or ignored by it)
STILLHERE_PERSONA_ROOT=

# ---- chat through the DeepSeek API (no GPU needed)
DEEPSEEK_API_KEY=
# (leave empty in this template; set it in .env or the environment)
# answer role: deepseek_api | openai_compatible_custom | huggingface_local (default)
STILLHERE_ANSWER_PROVIDER=
STILLHERE_ANSWER_MODEL=
# 1 = allow sending the persona prompt, the retrieved evidence and the message to the API provider (same as --allow-external-api)
STILLHERE_ALLOW_EXTERNAL_API=

# ---- any OpenAI-compatible endpoint (openai_compatible_custom)
STILLHERE_ANSWER_BASE_URL=
STILLHERE_CUSTOM_API_KEY=
# (leave empty in this template; set it in .env or the environment)
# ---- local models (CUDA GPU)
# a local Qwen3-8B directory (stillhere persona download-model base)
STILLHERE_BASE_MODEL_DIR=
# auto (default) | hf | hf-lowvram | fake (labelled dry run, not a model)
STILLHERE_LOCAL_BACKEND=
# cuda:0 (default), cuda:1, ...
STILLHERE_DEVICE=
STILLHERE_WRITER_MODEL_DIR=
STILLHERE_READER_MODEL_DIR=
STILLHERE_WRITER_MAX_NEW_TOKENS=
STILLHERE_MAX_CONTEXT_TOKENS=

# ---- dense memory: a local Qwen3-Embedding-0.6B directory (found automatically in the Hugging Face cache)
STILLHERE_EMBEDDING_MODEL_DIR=

# ---- router: rules (default) | llm
STILLHERE_ROUTER_MODE=

# ---- optional persona prompt provider (writes the persona prompt only): deterministic (default) | openai_compatible
STILLHERE_PROMPT_PROVIDER=
STILLHERE_PROMPT_API_BASE_URL=
STILLHERE_PROMPT_API_MODEL=
STILLHERE_PROMPT_API_KEY=
# (leave empty in this template; set it in .env or the environment)
# true sends example replies (private chat lines) to that provider; default false sends style statistics only
STILLHERE_PROMPT_SEND_EXAMPLES=

# ---- evaluation only (judge model, budgets)
STILLHERE_JUDGE_MODEL=
STILLHERE_JUDGE_PRICE_USD_IN=
STILLHERE_JUDGE_PRICE_USD_OUT=
STILLHERE_JUDGE_BUDGET_CNY=

# ---- legacy research retrieval experiments (Alibaba Cloud Model Studio); not used by the product
DASHSCOPE_API_KEY=
# (leave empty in this template; set it in .env or the environment)
STILLHERE_EMBEDDING_MODEL=
STILLHERE_RERANK_MODEL=
STILLHERE_DASHSCOPE_REGION=
STILLHERE_API_BUDGET_CNY=
